@startuml etape-01-activite-moyenne

title Étape 1 : Calcul de la moyenne avec variables individuelles

start

:note1 = 4.5;
:note2 = 5.0;
:note3 = 3.8;
:note4 = 4.2;
:note5 = 5.3;

:Afficher "Note 1 : note1";
:Afficher "Note 2 : note2";
:Afficher "Note 3 : note3";
:Afficher "Note 4 : note4";
:Afficher "Note 5 : note5";

:sum = note1 + note2 + note3 + note4 + note5;
:average = sum / 5;

:Afficher "Moyenne : average";

stop

@enduml
