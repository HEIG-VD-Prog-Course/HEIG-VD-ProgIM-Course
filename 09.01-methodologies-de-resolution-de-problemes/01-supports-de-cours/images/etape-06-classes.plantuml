@startuml etape-06-classes

title Étape 6 : Organisation avec fonctions

class Main {
  {static} +main(args: String[]) : void
  {static} -readGradeCount(scanner: Scanner) : int
  {static} -inputGrades(scanner: Scanner, grades: double[]) : void
  {static} -inputGrade(scanner: Scanner, index: int) : double
  {static} -displayGrades(grades: double[]) : void
  {static} -calculateMinimum(grades: double[]) : double
  {static} -calculateMaximum(grades: double[]) : double
  {static} -calculateAverage(grades: double[]) : double
  {static} -displayStatistics(min: double, max: double, average: double) : void
  {static} -modifyGrade(scanner: Scanner, grades: double[]) : void
}

note right of Main::readGradeCount
  Demande et valide le nombre
  de notes à saisir
end note

note right of Main::inputGrades
  Parcourt le tableau et saisit
  chaque note avec validation
end note

note right of Main::calculateMinimum
  Parcourt le tableau et trouve
  la valeur minimale
end note

note right of Main::modifyGrade
  Permet à l'utilisatrice de
  choisir et modifier une note
end note

@enduml
