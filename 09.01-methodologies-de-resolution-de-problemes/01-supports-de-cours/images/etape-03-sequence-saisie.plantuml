@startuml etape-03-sequence-saisie

title Étape 3 : Saisie d'une note avec validation

actor "Utilisatrice" as User
participant "Programme" as Prog

User -> Prog : Démarre le programme
activate Prog

loop Pour chaque note (i de 0 à 4)
  Prog -> User : "Entrez la note i+1 (entre 1.0 et 6.0)"
  
  loop Jusqu'à note valide
    User -> Prog : Saisit une valeur
    
    alt Valeur non numérique
      Prog -> User : "Erreur : veuillez entrer un nombre valide"
    else Valeur < 1.0 ou > 6.0
      Prog -> User : "Erreur : la note doit être entre 1.0 et 6.0"
    else Note valide
      Prog -> Prog : Stocke la note dans notes[i]
    end
  end
end

Prog -> User : Affiche toutes les notes
Prog -> User : Affiche les statistiques (min, max, moyenne)

deactivate Prog

@enduml
