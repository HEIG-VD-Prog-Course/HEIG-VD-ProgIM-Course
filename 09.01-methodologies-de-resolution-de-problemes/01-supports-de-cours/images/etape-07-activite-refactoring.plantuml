@startuml etape-07-activite-refactoring

title Étape 7 : Structure avec fonctions

start

:Je demande combien de notes
seront saisies;

:Je crée un tableau de la
taille appropriée;

:Je saisis toutes les notes
avec validation;

:J'affiche les notes saisies;

:Je calcule le minimum,
le maximum et la moyenne;

:J'affiche les statistiques;

if (L'utilisatrice veut-elle
modifier une note ?) then (oui)
  :Je demande quelle note modifier
  et la nouvelle valeur;
  
  :J'affiche les notes mises à jour;
  
  :Je recalcule les statistiques;
  
  :J'affiche les nouvelles statistiques;
endif

stop

@enduml
