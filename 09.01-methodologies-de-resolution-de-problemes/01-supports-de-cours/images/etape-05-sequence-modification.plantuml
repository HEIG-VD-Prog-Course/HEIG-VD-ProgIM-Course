@startuml etape-05-sequence-modification

title Étape 5 : Modification d'une note

actor "Utilisatrice" as User
participant "Programme" as Prog

note over Prog : Saisie et affichage déjà effectués

Prog -> User : "Souhaitez-vous modifier une note ? (oui/non)"
User -> Prog : Saisit "oui"

alt Réponse = "oui" ou "o"
  Prog -> User : "Quelle note souhaitez-vous modifier ? (1-n)"
  
  loop Jusqu'à index valide
    User -> Prog : Saisit un index
    
    alt Index non entier ou hors limites
      Prog -> User : Message d'erreur approprié
    else Index valide
      Prog -> User : "Note actuelle : notes[index]"
      Prog -> User : "Entrez la nouvelle note (entre 1.0 et 6.0)"
      
      loop Jusqu'à note valide
        User -> Prog : Saisit une nouvelle note
        
        alt Note invalide
          Prog -> User : Message d'erreur
        else Note valide
          Prog -> Prog : notes[index] = nouvelleNote
          Prog -> User : "Note modifiée avec succès !"
        end
      end
    end
  end
  
  Prog -> User : Affiche toutes les notes (mises à jour)
  Prog -> Prog : Recalcule min, max, moyenne
  Prog -> User : Affiche nouvelles statistiques
else Réponse = "non" ou "n"
  Prog -> User : "Aucune modification effectuée."
end

Prog -> User : "Programme terminé"

@enduml
